  <script>
    (function () {
      const wrap = document.getElementById('sfsOrdersWrap');
      const refreshBtn = document.getElementById('sfsRefreshBtn');

      function escapeHtml(str) {
        return String(str ?? '').replace(/[&<>"']/g, (m) => ({ '&':'&amp;','<':'<','>':'>','"':'"',"'":'&#039;'}[m]));
      }

      function statusClass(status) {
        if (status === 'DELIVERED') return 'delivered';
        if (status === 'IN_TRANSIT') return 'in-transit';
        return 'pending';
      }

      async function loadOrders() {
        try {
          wrap.innerHTML = '<div class="muted" style="font-weight:900;">Loading logistics ordersâ€¦</div>';

          const res = await fetch('api/logistics_orders.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: new URLSearchParams({ action: 'list_orders' }).toString()
          });
          const data = await res.json();
          if (!data.ok) throw new Error(data.error || 'Failed to load orders');

          const orders = data.orders || [];
          if (!orders.length) {
            wrap.innerHTML = '<div class="card">No customer orders yet. Orders appear here once a customer confirms checkout.</div>';
            return;
          }

          wrap.innerHTML = orders.map((o) => {
            const itemsHtml = (o.items || []).map((it) => `
              <div class="sfs-order-item">
                ${it.logo_path ? `<img src="${escapeHtml(it.logo_path)}" alt="" onerror="this.style.display='none'" />` : '<img src="" alt="" style="visibility:hidden;" />'}
                <div style="flex:1; min-width:0;">
                  <div style="font-weight:1000; color:#fff;">${escapeHtml(it.product_name)}</div>
                  <div class="muted" style="font-size:0.78rem; font-weight:900;">SKU: ${escapeHtml(it.product_sku || 'â€”')}</div>
                </div>
                <div style="font-weight:1000; color:#f5d76c;">Qty: ${it.qty}</div>
              </div>
            `).join('');

            return `
              <div class="sfs-order-card">
                <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px; flex-wrap:wrap;">
                  <div>
                    <div style="font-weight:1000; font-size:1.05rem; color:#f5d76c;">${escapeHtml(o.order_id)}</div>
                    <div class="muted" style="margin-top:4px; font-weight:900;">Customer: ${escapeHtml(o.customer_name)}</div>
                    <div class="muted" style="margin-top:2px; font-weight:900;">Mobile: +91 ${escapeHtml(o.customer_phone || 'â€”')}</div>
                    <div class="muted" style="margin-top:2px; font-weight:900;">Items: ${o.item_count}</div>
                    <div class="muted" style="margin-top:6px; font-weight:900;">ðŸ“ ${escapeHtml(o.delivery_address || 'â€”')}</div>
                  </div>
                  <div style="text-align:right;">
                    <span class="sfs-status-pill ${statusClass(o.status)}">${escapeHtml(o.status_label)}</span>
                    <div class="muted" style="margin-top:6px; font-size:0.75rem;">Updated: ${escapeHtml(o.status_updated_at || 'â€”')}</div>
                  </div>
                </div>

                <div style="margin-top:12px; display:grid; gap:8px;" class="sfs-order-items">${itemsHtml}</div>

                <div style="margin-top:14px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                  <select class="sfs-status-select" data-order-id="${escapeHtml(o.order_id)}" style="padding:10px 12px; border-radius:12px; border:1px solid rgba(212,175,55,0.35); background:rgba(0,0,0,0.3); color:#fff; font-weight:900;">
                    <option value="ASSIGNED" ${o.status === 'ASSIGNED' ? 'selected' : ''}>Assigned</option>
                    <option value="IN_TRANSIT" ${o.status === 'IN_TRANSIT' ? 'selected' : ''}>In-Transit</option>
                    <option value="DELIVERED" ${o.status === 'DELIVERED' ? 'selected' : ''}>Delivered</option>
                  </select>
                  <button type="button" class="sfs-btn primary sfs-update-btn" data-order-id="${escapeHtml(o.order_id)}" ${o.status === 'DELIVERED' ? 'disabled' : ''}>
                    ${o.status === 'DELIVERED' ? 'âœ… Delivered' : 'Update Delivery Status'}
                  </button>
                </div>
              </div>
            `;
          }).join('');

          wireButtons();
        } catch (e) {
          console.error(e);
          wrap.innerHTML = '<div class="card" style="color:#f87171;">Error loading logistics orders.</div>';
        }
      }

      function wireButtons() {
        wrap.querySelectorAll('.sfs-update-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const orderId = btn.getAttribute('data-order-id');
            const select = wrap.querySelector(`.sfs-status-select[data-order-id="${CSS.escape(orderId)}"]`);
            const status = select ? select.value : 'DELIVERED';

            btn.disabled = true;
            btn.textContent = 'â³ Updatingâ€¦';

            try {
              const res = await fetch('api/logistics_orders.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: new URLSearchParams({ action: 'update_status', order_id: orderId, status }).toString()
              });
              const data = await res.json();
              if (!data.ok) throw new Error(data.error || 'Update failed');

              alert('Order #' + data.order_id + ' â†’ ' + data.status_label
                + (status === 'DELIVERED'
                  ? '\n\nAutomated delivery SMS ' + (data.sms_sent ? 'sent to customer âœ“' : 'NOT sent (' + (data.sms_error || 'unknown') + ')')
                  : ''));
              loadOrders();
            } catch (e) {
              console.error(e);
              alert('Update failed: ' + (e.message || 'Unknown error'));
              btn.disabled = false;
              btn.textContent = 'Update Delivery Status';
            }
          });
        });
      }

      refreshBtn.addEventListener('click', loadOrders);
      document.getElementById('year').textContent = new Date().getFullYear();
      loadOrders();
    })();
  </script>

